    { id: 3, name: 'ขนมคละ', category: 'ขนม', price: 5.5, stock: 300, image: 'https://images.unsplash.com/photo-1553163147-9f0b2d9d4e4d?auto=format&fit=crop&w=900&q=80' },
    { id: 4, name: 'พืชไร่คละ', category: 'พืชผล', price: 3, stock: 1000, image: 'https://images.unsplash.com/photo-1464226184884-fa52ac9fc5a0?auto=format&fit=crop&w=900&q=80' },
    { id: 5, name: 'วัสดุขยายพื้นที่', category: 'วัสดุ', price: 10, stock: 100, image: 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=900&q=80' },
